# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sanket

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Twilio WhatsApp and Voice
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1234567890

# Google Maps server-side APIs
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxx

# Client URL for CORS and tracking links
CLIENT_URL=http://localhost:5173

# SOS tracking and notification behavior
TRACKING_LINK_TTL_HOURS=24
RESOLVED_TRACKING_TTL_MINUTES=60
SOS_NOTIFICATION_MAX_ATTEMPTS=3

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — use either DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sanket
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=sanket
# Set to true for managed Postgres that requires SSL (e.g. Supabase/Neon/RDS)
PG_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Twilio Voice (emergency calls only — WhatsApp has moved to Meta Cloud API)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=8000
# Approved template names (required to alert contacts outside a 24h window)
WHATSAPP_SOS_TEMPLATE=sanket_sos_alert
WHATSAPP_ALLCLEAR_TEMPLATE=sanket_all_clear
WHATSAPP_TEMPLATE_LANG=en

# Maps: nearby places via OpenStreetMap Overpass + reverse geocode via Nominatim.
# No API key required — these are keyless public services.

# Client URL for CORS and tracking links
CLIENT_URL=http://localhost:5173

# SOS tracking and notification behavior
TRACKING_LINK_TTL_HOURS=24
RESOLVED_TRACKING_TTL_MINUTES=60
SOS_NOTIFICATION_MAX_ATTEMPTS=3

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Testing & Safety Controls
# Set to 'true' ONLY when executing server/test-db-smoke.js against a dedicated, disposable scratch database.
# NEVER enable on production or shared databases.
ALLOW_DESTRUCTIVE_DB_TEST=false

# Optional Client Dev Helpers (Vite)
# VITE_DEV_LOGIN_EMAIL=
# VITE_DEV_LOGIN_PASSWORD=

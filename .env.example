# ──── Server ────
PORT=5000
NODE_ENV=development

# ──── MongoDB Atlas ────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sanket

# ──── JWT ────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# ──── WhatsApp Business Cloud API ────
WHATSAPP_API_TOKEN=EAAxxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ──── Twilio Voice ────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ──── Google Maps (Server-side for Places API) ────
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxx

# ──── Client URL (for CORS & tracking links) ────
CLIENT_URL=http://localhost:5173

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview
